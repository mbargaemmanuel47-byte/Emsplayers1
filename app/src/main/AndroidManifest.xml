<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================================== -->
    <!-- PERMISSIONS SYSTÈME OPTIMISÉES POUR ANDROID 7 (API 24) À ANDROID 15   -->
    <!-- Conforme aux politiques Google Play (principe du moindre privilège)   -->
    <!-- ===================================================================== -->

    <!-- Réseau & Firebase AI Logic -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lecture audio continue & verrouillage processeur -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Service au premier plan pour lecture multimédia (Android 9+ / API 28+ & Android 14+ / API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Notifications multimédias & alertes Mix IA (Android 13+ / API 33-35) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Accès sécurisé aux fichiers audio locaux :
         - Android 13 à 15 (API 33+) : READ_MEDIA_AUDIO (granulaire)
         - Android 7 à 12 (API 24-32) : READ_EXTERNAL_STORAGE limité à maxSdkVersion 32 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Routage audio Bluetooth / Casques haute-fidélité :
         - Android 7 à 11 (API 24-30) : BLUETOOTH limité à maxSdkVersion 30
         - Android 12 à 15 (API 31+) : BLUETOOTH_CONNECT (runtime) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Déclarations matérielles optionnelles (compatibilité étendue Play Store) -->
    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:appCategory="audio"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmsPlayer"
        android:usesCleartextTraffic="false"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EmsPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Service de lecture audio en arrière-plan compatible Android 7 à 15 -->
        <service
            android:name=".audio.AuraPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
